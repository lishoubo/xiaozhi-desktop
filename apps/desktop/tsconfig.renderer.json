{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],
    "paths": {
      "$lib": ["./src/renderer"],
      "$lib/*": ["./src/renderer/*"]
    }
  },
  "include": [
    "src/renderer.ts",
    "src/renderer/**/*.ts",
    "src/renderer/**/*.svelte",
    "src/vite-env.d.ts"
  ]
}
