{
  "env": {
    "browser": true,
    "es6": true,
    "node": true
  },
  "extends": [
    "eslint:recommended",
    "plugin:@typescript-eslint/eslint-recommended",
    "plugin:@typescript-eslint/recommended",
    "plugin:import/recommended",
    "plugin:import/electron",
    "plugin:import/typescript",
    "prettier"
  ],
  "parser": "@typescript-eslint/parser",
  "parserOptions": {
    "sourceType": "module"
  },
  "rules": {
    "@typescript-eslint/no-unused-vars": [
      "error",
      {
        "argsIgnorePattern": "^_"
      }
    ],
    "import/no-restricted-paths": [
      "error",
      {
        "zones": [
          {
            "target": "./src/shared",
            "from": "./src/main",
            "message": "shared 不能依赖 main（依赖方向是 main → shared）"
          },
          {
            "target": "./src/shared",
            "from": "./src/renderer",
            "message": "shared 不能依赖 renderer（依赖方向反了）"
          },
          {
            "target": "./src/renderer",
            "from": "./src/main",
            "message": "renderer 只能通过 preload 访问 main"
          },
          // channels/ 是被注入的渠道适配器：输入凭证 + 页面，输出探测结果。
          // 唯一放行的外部依赖是 ota-tab/（需要订阅标签页事实），这里不写它的
          // zone 是有意为之，不是遗漏——no-restricted-paths 是默认允许、显式禁止。
          {
            "target": "./src/main/channels",
            "from": "./src/main/services",
            "message": "channels/ 是被注入的渠道适配器，不得反向依赖 services/；需要什么就注入窄回调"
          },
          {
            "target": "./src/main/channels",
            "from": "./src/main/database",
            "message": "channels/ 不直接落库；持久化由 composition root 注入的回调完成"
          },
          {
            "target": "./src/main/channels",
            "from": "./src/main/gateway",
            "message": "channels/ 不直接访问远端网关；需要什么就注入窄回调"
          },
          {
            "target": "./src/main/channels",
            "from": "./src/main/ipc",
            "message": "channels/ 不认识 IPC 边界"
          },
          {
            "target": "./src/main/channels",
            "from": "./src/main/composition",
            "message": "channels/ 不得依赖装配层（依赖方向是 composition → channels）"
          }
        ]
      }
    ]
  },
  "overrides": [
    {
      // ids.ts 是标识符校验，跨层共用，必须零框架依赖
      "files": ["src/main/ids.ts", "src/shared/types/**/*.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              { "name": "electron", "message": "标识与共享类型必须零框架依赖" },
              { "name": "better-sqlite3", "message": "标识与共享类型不做 I/O" },
              { "name": "svelte", "message": "标识与共享类型不认 UI" },
              { "name": "node:fs", "message": "标识与共享类型不做 I/O" },
              { "name": "node:child_process", "message": "标识与共享类型不起进程" }
            ],
            "patterns": [
              {
                "group": ["**/main/**"],
                "message": "shared/ 不得依赖 main/：依赖方向是 main → shared"
              }
            ]
          }
        ]
      }
    },
    {
      // 实现类只能在 composition root 装配
      "files": ["src/main/**/*.ts"],
      "excludedFiles": ["src/main/composition/**/*.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["**/calendar/calendar-repository", "**/browser/browser-manager"],
                "message": "实现类只能在 composition root（src/main/composition/）装配；这里请依赖窄接口"
              }
            ]
          }
        ]
      }
    },
    {
      // IPC 层只做边界：信任校验 → 参数校验 → 调一个 service → 错误转换
      "files": ["src/main/ipc/**/*.ts"],
      "excludedFiles": ["src/main/ipc/create-handler-registry.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "electron",
                "message": "ipc/ 不直接使用 electron；ipcMain 收在 create-handler-registry.ts，其余能力走 service"
              }
            ],
            "patterns": [
              {
                "group": [
                  "**/database/**",
                  "**/file-store/**",
                  "**/cookie-import/**",
                  "**/browser/**",
                  "**/server-client/**",
                  "**/repositories"
                ],
                "message": "ipc/ 不得直连仓储或基础设施，请通过 services/ 访问"
              }
            ]
          }
        ]
      }
    },
    {
      // service 是业务编排，不碰 Electron，也不自己开 tab
      "files": ["src/main/services/**/*.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["**/browser/browser-manager", "**/ota-tab/**"],
                "message": "service 不直接开 tab；OTA 标签页的唯一开口是 main/ota-tab/"
              }
            ]
          }
        ]
      }
    },
    {
      // 渠道适配器实现 channels/types.ts 的接口，不反向依赖编排层
      "files": ["src/main/channels/**/*.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["**/services/**", "**/ipc/**", "**/composition/**"],
                "message": "channels/ 是被注入的适配器，不得反向依赖编排层"
              }
            ]
          }
        ]
      }
    },
    {
      // renderer 只能通过 preload 访问主进程
      "files": ["src/renderer/**/*.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["**/main/**"],
                "message": "renderer 不得 import main/：只能通过 preload 暴露的 API 访问主进程"
              }
            ]
          }
        ]
      }
    }
  ]
}
