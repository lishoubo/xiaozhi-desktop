# Copy this file to .env.production and replace every required placeholder.
# Keep .env.production private; production secrets must never be committed.

# =============================================================================
# 1. PostgreSQL
# PostgreSQL is the only database managed by the production Compose project.
# DATABASE_URL is used by the server and database initializer inside Compose.
# Keep its username, password, and database in sync with POSTGRES_*.
# =============================================================================
POSTGRES_USER="hotel_butler_app"
POSTGRES_PASSWORD="replace-with-postgres-password"
POSTGRES_DB="hotel_butler"
POSTGRES_DATA_DIR="/var/lib/hotel-butler/postgresql"
POSTGRES_BIND_ADDRESS="0.0.0.0"
POSTGRES_PORT="35432"
# Restrict inbound TCP 35432 to trusted source IPs in the host/cloud firewall.
DATABASE_URL="postgres://hotel_butler_app:replace-with-postgres-password@db:35432/hotel_butler"

# =============================================================================
# 2. Desktop account/password authentication
# The default production desktop uses staff login. The server validates its
# Electron Bearer identity through this HTTPS RMS API. Phone routes also remain
# registered; add RMS_DATABASE_URL only if that identity source is needed later.
# =============================================================================
XIAOZHI_RMS_SERVER_URL="https://replace-with-rms-api-domain"

# =============================================================================
# 3. Private-CA HTTPS
# Public HTTPS is fixed at 121.199.29.74:35443. The certificate directory on the server must contain:
# cert.pem (server certificate + intermediates), key.pem (server private key), ca.pem (public CA).
# =============================================================================
ORIGIN="https://121.199.29.74:35443"
SERVER_BIND_ADDRESS="0.0.0.0"
SERVER_HTTPS_PORT="35443"
SERVER_TLS_CERT_DIR="/opt/hotel-butler/tls/server"
SERVER_LOG_DIR="/var/log/hotel-butler/server"

# =============================================================================
# 4. Authentication
# Generate a unique value with at least 32 high-entropy characters.
# =============================================================================
BETTER_AUTH_SECRET="replace-with-32+-character-high-entropy-secret"

# =============================================================================
# 5. Hotel Agent
# AI_KIMI_API_KEY is server-only. MCP defaults to read-only tool names; explicitly
# review every configured server before enabling write tools.
# =============================================================================
AI_KIMI_API_KEY="replace-with-kimi-api-key"
# Server-only token for the bundled Aliyun DMS hotel data MCP.
AI_DMS_MCP_BEARER_TOKEN="replace-with-rotated-dms-token"
AI_DMS_DATABASE_NAME="rms_data"

# =============================================================================
# 6. Initial administrator
# These values are used when the production database is initialized.
# =============================================================================
INITIAL_ADMIN_NAME="replace-with-production-administrator-name"
INITIAL_ADMIN_USERNAME="replace_with_unpredictable_admin_username"
INITIAL_ADMIN_PASSWORD="replace-with-16+-mixed-case-number-symbol-password"
