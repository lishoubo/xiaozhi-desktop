# Copy this file to .env.production and replace every required placeholder.
# Keep .env.production private; production secrets must never be committed.

# =============================================================================
# 1. Container images
# Images mirrored or published to Alibaba Cloud Container Registry (ACR).
# =============================================================================
ALIYUN_REGISTRY="registry.cn-<region>.aliyuncs.com"
ALIYUN_NAMESPACE="replace-with-acr-namespace"
PGVECTOR_IMAGE_TAG="replace-with-approved-pgvector-tag"
SERVER_IMAGE_TAG="replace-with-release-tag"

# =============================================================================
# 2. PostgreSQL
# PostgreSQL is the only database managed by the production Compose project.
# DATABASE_URL is used by the server and database initializer inside Compose.
# Keep its username, password, and database in sync with POSTGRES_*.
# =============================================================================
POSTGRES_USER="replace-with-postgres-user"
POSTGRES_PASSWORD="replace-with-postgres-password"
POSTGRES_DB="replace-with-postgres-database"
POSTGRES_DATA_DIR="/replace/with/absolute/postgresql/data/path"
DATABASE_URL="postgres://replace-with-user:replace-with-password@db:5432/replace-with-database"

# =============================================================================
# 3. RMS MySQL
# RMS MySQL is external in production and must be accessed with a read-only account.
# This project does not create or manage the production RMS database.
# =============================================================================
RMS_DATABASE_URL="mysql://replace-with-readonly-user:replace-with-password@replace-with-rms-host:3306/replace-with-database"

# =============================================================================
# 4. Public origin and server binding
# Caddy terminates public HTTPS and proxies to the loopback-bound server port.
# =============================================================================
ORIGIN="https://replace-with-production-domain"
SERVER_BIND_ADDRESS="127.0.0.1"
SERVER_PORT="3000"

# =============================================================================
# 5. Authentication
# Generate a unique value with at least 32 high-entropy characters.
# =============================================================================
BETTER_AUTH_SECRET="replace-with-32+-character-high-entropy-secret"

# =============================================================================
# 6. Initial administrator
# These values are used when the production database is initialized.
# =============================================================================
INITIAL_ADMIN_NAME="replace-with-production-administrator-name"
INITIAL_ADMIN_USERNAME="replace_with_unpredictable_admin_username"
INITIAL_ADMIN_PASSWORD="replace-with-16+-mixed-case-number-symbol-password"

# =============================================================================
# 7. Logging
# Allowed levels: trace, debug, info, warn, error, fatal, silent.
# =============================================================================
LOG_LEVEL="info"
