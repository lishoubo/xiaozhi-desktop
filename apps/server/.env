# =============================================================================
# 1. Host-run server: database connections
# Used by `npm run dev:server`. Both databases are reached through localhost.
# When credentials below change, update the matching URL here as well.
# =============================================================================
DATABASE_URL="postgres://root:mysecretpassword@localhost:5432/local"
RMS_DATABASE_URL="mysql://hotel_butler:mysecretpassword@localhost:3306/rms"

# =============================================================================
# 2. Local PostgreSQL container
# POSTGRES_* creates/configures PostgreSQL on first initialization.
# POSTGRES_HOST_PORT exposes it to the host-run server.
# COMPOSE_DATABASE_URL is used only by the server running inside Docker Compose.
# Keep its username, password, and database in sync with POSTGRES_* above it.
# =============================================================================
POSTGRES_HOST_PORT="5432"
POSTGRES_USER="root"
POSTGRES_PASSWORD="mysecretpassword"
POSTGRES_DB="local"
COMPOSE_DATABASE_URL="postgres://root:mysecretpassword@db:5432/local"

# =============================================================================
# 3. Local RMS MySQL container
# MYSQL_* creates/configures MySQL on first initialization.
# RMS_HOST_PORT exposes it to the host-run server.
# COMPOSE_RMS_DATABASE_URL is used only by the server running inside Docker Compose.
# Keep its username, password, and database in sync with MYSQL_* below it.
# MYSQL_ROOT_PASSWORD is for container administration, not the application connection.
# =============================================================================
RMS_HOST_PORT="3306"
MYSQL_ROOT_PASSWORD="rootsecretpassword"
MYSQL_DATABASE="rms"
MYSQL_USER="hotel_butler"
MYSQL_PASSWORD="mysecretpassword"
COMPOSE_RMS_DATABASE_URL="mysql://hotel_butler:mysecretpassword@rms:3306/rms"

# =============================================================================
# 4. Server runtime
# =============================================================================
TZ="Asia/Shanghai"
ORIGIN="https://localhost:5173"

# =============================================================================
# 5. Authentication
# =============================================================================
# Better Auth
# For production use 32 characters and generated with high entropy
# https://www.better-auth.com/docs/installation
BETTER_AUTH_SECRET="0OzvJS26a7OF0kVyex3Ls1eqTSdaNVbv"

AI_KIMI_API_KEY="sk-nOy1f86IW52ZkErMwbDSxV8qNBxijpLENgtSvepa9vLZsZYo"
