{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM"],
    "types": ["node"]
  },
  "include": [
    "src/main.ts",
    "src/preload.ts",
    "src/main/**/*.ts",
    "src/preload/**/*.ts",
    "src/shared/**/*.ts",
    "src/renderer/app.d.ts",
    "tests/unit/**/*.ts",
    "tests/e2e/**/*.ts",
    "*.ts",
    "*.mts"
  ]
}
