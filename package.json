{
  "name": "hotel-butler",
  "productName": "hotel-butler",
  "version": "1.0.0",
  "description": "My Electron application description",
  "main": ".vite/build/main.js",
  "private": true,
  "scripts": {
    "start": "electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "publish": "electron-forge publish",
    "check": "npm run check:types && npm run check:svelte",
    "check:types": "tsc --noEmit --project tsconfig.node.json",
    "check:svelte": "svelte-check --tsconfig ./tsconfig.renderer.json",
    "lint": "eslint --ext .ts,.tsx,.mts .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "drizzle-kit generate",
    "db:check": "drizzle-kit check",
    "db:studio": "drizzle-kit studio",
    "test": "npm run test:unit && npm run test:component",
    "test:all": "npm test && npm run test:e2e",
    "test:unit": "vitest run --config vitest.unit.config.mts",
    "test:unit:watch": "vitest --config vitest.unit.config.mts",
    "test:component": "vitest run --config vitest.component.config.mts",
    "test:component:watch": "vitest --config vitest.component.config.mts",
    "test:coverage": "npm run test:unit -- --coverage && npm run test:component -- --coverage",
    "build:e2e": "vite build --config tests/e2e/config/vite.renderer.config.mts && vite build --config tests/e2e/config/vite.main.config.mts && vite build --config tests/e2e/config/vite.preload.config.mts",
    "test:e2e": "npm run build:e2e && playwright test"
  },
  "keywords": [],
  "license": "MIT",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.11.2",
    "@electron-forge/maker-deb": "^7.11.2",
    "@electron-forge/maker-rpm": "^7.11.2",
    "@electron-forge/maker-squirrel": "^7.11.2",
    "@electron-forge/maker-zip": "^7.11.2",
    "@electron-forge/plugin-auto-unpack-natives": "^7.11.2",
    "@electron-forge/plugin-fuses": "^7.11.2",
    "@electron-forge/plugin-vite": "^7.11.2",
    "@electron/fuses": "^1.8.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@internationalized/date": "^3.12.3",
    "@lucide/svelte": "^1.27.0",
    "@playwright/test": "^1.62.0",
    "@sveltejs/vite-plugin-svelte": "^4.0.4",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/svelte": "^5.4.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/electron-squirrel-startup": "^1.0.2",
    "@types/node": "^24.13.3",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "@vitest/coverage-v8": "3.2.6",
    "bits-ui": "^2.18.1",
    "clsx": "^2.1.1",
    "drizzle-kit": "^0.31.10",
    "electron": "43.2.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "jsdom": "^26.1.0",
    "prettier": "3.9.6",
    "prettier-plugin-svelte": "4.1.1",
    "shadcn-svelte": "^1.4.2",
    "svelte-check": "^4.7.4",
    "tailwind-merge": "^3.6.0",
    "tailwind-variants": "^3.3.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vite": "^5.4.21",
    "vitest": "3.2.6"
  },
  "dependencies": {
    "@tanstack/svelte-query": "^6.1.38",
    "better-sqlite3": "^13.0.2",
    "drizzle-orm": "^0.45.2",
    "electron-log": "^5.4.4",
    "electron-squirrel-startup": "^1.0.1",
    "svelte": "^5.56.8",
    "svelte-spa-router": "^5.1.1"
  }
}
