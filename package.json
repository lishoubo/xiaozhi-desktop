{
  "name": "@hotel-butler/workspace",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:desktop": "npm run dev:desktop:staff",
    "dev:desktop:staff": "node --experimental-strip-types apps/desktop/scripts/run-auth-profile.ts staff dev",
    "dev:desktop:phone": "node --experimental-strip-types apps/desktop/scripts/run-auth-profile.ts phone dev",
    "dev:server": "npm run dev --workspace @hotel-butler/server",
    "build": "npm run build --workspaces --if-present",
    "build:server": "npm run build --workspace @hotel-butler/server",
    "build:e2e:desktop": "npm run build:e2e --workspace @hotel-butler/desktop",
    "package:desktop": "npm run package:desktop:staff",
    "package:desktop:staff": "node --experimental-strip-types apps/desktop/scripts/run-auth-profile.ts staff package",
    "package:desktop:phone": "node --experimental-strip-types apps/desktop/scripts/run-auth-profile.ts phone package",
    "make:desktop": "npm run make:desktop:staff",
    "make:desktop:staff": "node --experimental-strip-types apps/desktop/scripts/run-auth-profile.ts staff make",
    "make:desktop:phone": "node --experimental-strip-types apps/desktop/scripts/run-auth-profile.ts phone make",
    "make:desktop:mac:intel": "node --experimental-strip-types apps/desktop/scripts/run-auth-profile.ts staff make:mac:intel",
    "make:desktop:mac:arm64": "node --experimental-strip-types apps/desktop/scripts/run-auth-profile.ts staff make:mac:arm64",
    "make:desktop:win64": "node --experimental-strip-types apps/desktop/scripts/run-auth-profile.ts staff make:win64",
    "check": "npm run check --workspaces --if-present",
    "check:desktop": "npm run check --workspace @hotel-butler/desktop",
    "check:server": "npm run check --workspace @hotel-butler/server",
    "check:api": "npm run check --workspace @hotel-butler/api",
    "lint": "npm run lint --workspaces --if-present",
    "lint:desktop": "npm run lint --workspace @hotel-butler/desktop",
    "lint:server": "npm run lint --workspace @hotel-butler/server",
    "lint:api": "npm run lint --workspace @hotel-butler/api",
    "format": "npm run format --workspaces --if-present",
    "format:check": "npm run format:check --workspaces --if-present",
    "test": "npm run test:unit",
    "test:all": "npm test && npm run test:e2e",
    "test:unit": "npm run test:unit --workspaces --if-present",
    "test:unit:desktop": "npm run test:unit --workspace @hotel-butler/desktop",
    "test:unit:server": "npm run test:unit --workspace @hotel-butler/server",
    "test:unit:api": "npm run test:unit --workspace @hotel-butler/api",
    "test:e2e": "npm run test:e2e:desktop && npm run test:e2e:server",
    "test:e2e:desktop": "npm run test:e2e --workspace @hotel-butler/desktop",
    "test:e2e:server": "npm run test:e2e --workspace @hotel-butler/server",
    "test:compose:server": "npm run compose:local:test --workspace @hotel-butler/server",
    "test:coverage:desktop": "npm run test:coverage --workspace @hotel-butler/desktop",
    "test:unit:desktop:watch": "npm run test:unit:watch --workspace @hotel-butler/desktop",
    "test:unit:server:watch": "npm run test:unit:watch --workspace @hotel-butler/server",
    "verify": "npm run check && npm run lint && npm run test:all",
    "https:setup": "npm run https:setup --workspace @hotel-butler/server",
    "https:setup:production": "node apps/server/scripts/setup-production-ip-https.mjs",
    "env:setup:production": "node apps/server/scripts/setup-production-environment.mjs",
    "package:desktop:production": "node --experimental-strip-types apps/desktop/scripts/package-production.ts",
    "package:server:source": "node --experimental-strip-types apps/server/scripts/package-production-source.ts",
    "package:server:production:source": "node --experimental-strip-types apps/server/scripts/package-production-source.ts --include-runtime",
    "package:server:images": "bash apps/server/scripts/package-production-images.sh",
    "package:server:production": "bash apps/server/scripts/package-production-images.sh",
    "upload:server:images": "bash apps/server/scripts/upload-production-images.sh",
    "upload:server:production": "npm run upload:server:images --",
    "prepare:server:production-host": "bash apps/server/scripts/prepare-production-host.sh",
    "db:validate": "npm run db:validate --workspace @hotel-butler/desktop",
    "db:start": "npm run db:start --workspace @hotel-butler/server",
    "compose:dev:config": "npm run compose:local:config --workspace @hotel-butler/server",
    "compose:dev:up": "npm run compose:local:up --workspace @hotel-butler/server",
    "compose:dev:logs": "npm run compose:local:logs --workspace @hotel-butler/server",
    "compose:dev:down": "npm run compose:local:down --workspace @hotel-butler/server",
    "compose:prod:config": "npm run compose:production:config --workspace @hotel-butler/server",
    "compose:prod:up": "npm run compose:production:up --workspace @hotel-butler/server",
    "compose:prod:logs": "npm run compose:production:logs --workspace @hotel-butler/server",
    "compose:prod:down": "npm run compose:production:down --workspace @hotel-butler/server",
    "compose:local": "npm run compose:dev:up",
    "compose:production": "npm run compose:prod:up",
    "server:compose:up": "npm run compose:local",
    "server:compose:production:config": "npm run compose:production:config --workspace @hotel-butler/server",
    "db:generate": "npm run db:generate --workspace @hotel-butler/server",
    "db:migrate": "npm run db:migrate --workspace @hotel-butler/server",
    "db:push": "npm run db:push --workspace @hotel-butler/server",
    "db:studio": "npm run db:studio --workspace @hotel-butler/server",
    "auth:schema": "npm run auth:schema --workspace @hotel-butler/server"
  },
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11"
  },
  "allowScripts": {
    "better-sqlite3@13.0.2": true
  }
}
