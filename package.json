{
  "name": "@hotel-butler/workspace",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:desktop": "node scripts/desktop-dev.mjs",
    "dev:server": "npm run dev --workspace @hotel-butler/server",
    "build": "npm run build --workspaces --if-present",
    "build:server": "npm run build --workspace @hotel-butler/server",
    "build:e2e:desktop": "npm run build:e2e --workspace @hotel-butler/desktop",
    "package:desktop": "node scripts/desktop-make.mjs --env=dev --package-only",
    "clean:desktop": "node scripts/desktop-clean.mjs",
    "make:desktop:pre": "node scripts/desktop-make.mjs --env=pre",
    "make:desktop:pre:mac:arm64": "node scripts/desktop-make.mjs --env=pre --target=mac-arm64",
    "make:desktop:pre:mac:intel": "node scripts/desktop-make.mjs --env=pre --target=mac-intel",
    "make:desktop:pre:win64": "node scripts/desktop-make.mjs --env=pre --target=win64",
    "make:desktop:online": "node scripts/desktop-make.mjs --env=online",
    "make:desktop:online:mac:arm64": "node scripts/desktop-make.mjs --env=online --target=mac-arm64",
    "make:desktop:online:mac:intel": "node scripts/desktop-make.mjs --env=online --target=mac-intel",
    "make:desktop:online:win64": "node scripts/desktop-make.mjs --env=online --target=win64",
    "check": "npm run check --workspaces --if-present",
    "check:desktop": "npm run check --workspace @hotel-butler/desktop",
    "check:server": "npm run check --workspace @hotel-butler/server",
    "check:api": "npm run check --workspace @hotel-butler/api",
    "lint": "npm run lint --workspaces --if-present",
    "lint:desktop": "npm run lint --workspace @hotel-butler/desktop",
    "lint:server": "npm run lint --workspace @hotel-butler/server",
    "lint:api": "npm run lint --workspace @hotel-butler/api",
    "format": "npm run format --workspaces --if-present",
    "format:check": "npm run format:check --workspaces --if-present",
    "test": "npm run test:unit",
    "test:all": "npm test && npm run test:e2e",
    "test:unit": "npm run test:unit --workspaces --if-present",
    "test:unit:desktop": "npm run test:unit --workspace @hotel-butler/desktop",
    "test:unit:server": "npm run test:unit --workspace @hotel-butler/server",
    "test:unit:api": "npm run test:unit --workspace @hotel-butler/api",
    "test:e2e": "npm run test:e2e:desktop && npm run test:e2e:server",
    "test:e2e:desktop": "npm run test:e2e --workspace @hotel-butler/desktop",
    "test:e2e:server": "npm run test:e2e --workspace @hotel-butler/server",
    "test:compose:server": "npm run compose:local:test --workspace @hotel-butler/server",
    "test:coverage:desktop": "npm run test:coverage --workspace @hotel-butler/desktop",
    "test:unit:desktop:watch": "npm run test:unit:watch --workspace @hotel-butler/desktop",
    "test:unit:server:watch": "npm run test:unit:watch --workspace @hotel-butler/server",
    "verify": "npm run check && npm run lint && npm run test:all",
    "https:setup": "npm run https:setup --workspace @hotel-butler/server",
    "db:validate": "npm run db:validate --workspace @hotel-butler/desktop",
    "db:start": "npm run db:start --workspace @hotel-butler/server",
    "compose:local": "npm run compose:local:up --workspace @hotel-butler/server",
    "compose:production": "npm run compose:production:up --workspace @hotel-butler/server",
    "server:compose:up": "npm run compose:local",
    "server:compose:production:config": "npm run compose:production:config --workspace @hotel-butler/server",
    "db:generate": "npm run db:generate --workspace @hotel-butler/server",
    "db:migrate": "npm run db:migrate --workspace @hotel-butler/server",
    "db:push": "npm run db:push --workspace @hotel-butler/server",
    "db:studio": "npm run db:studio --workspace @hotel-butler/server",
    "auth:schema": "npm run auth:schema --workspace @hotel-butler/server"
  },
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11"
  },
  "allowScripts": {
    "better-sqlite3@13.0.2": true
  }
}
